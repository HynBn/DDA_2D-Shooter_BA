      m_Calls: []
  m_text: "Welcome! This game is part of my Bachelor's thesis.\n\nIt features a custom
    \nDynamic Difficulty Adjustment (DDA) system. Instead of choosing \"Easy\" or
    \"Hard,\" the enemy AI observes your performance in real-time and automatically
    adapts its behavior. \n\nThe goal? To keep you perfectly balanced between boredom
    and frustration in the ultimate \"Flow\" state."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6acc01063bb6140edb30867e5d68ce55, type: 2}
